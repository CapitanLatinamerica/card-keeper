        <item name="colorOnTertiaryContainer">@color/Nad_on_tertiary_container</item>
        <item name="colorOnErrorContainer">@color/Nad_on_error_container</item>

        <item name="colorSurfaceDim">@color/Nad_surface_dim</item>
