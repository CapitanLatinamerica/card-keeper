        <item name="colorOnPrimary">@color/Nad_on_primary</item>
        <item name="colorOnSecondary">@color/Nad_on_secondary</item>
        <item name="colorOnTertiary">@color/Nad_on_tertiary</item>
        <item name="colorOnError">@color/Nad_on_error</item>

        <item name="colorPrimaryContainer">@color/Nad_primary_container</item>
        <item name="colorSecondaryContainer">@color/Nad_secondary_container</item>
        <item name="colorTertiaryContainer">@color/Nad_tertiary_container</item>
        <item name="colorErrorContainer">@color/Nad_error_container</item>

        <item name="colorOnPrimaryContainer">@color/Nad_on_primary_container</item>
