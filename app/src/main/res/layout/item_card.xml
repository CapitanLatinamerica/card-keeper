<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="center"
        android:layout_marginHorizontal="4dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <!-- Основное содержимое карточки -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Фотография карты (заполняет всю карточку) -->
            <ImageView
                android:id="@+id/cardImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_card_placeholder" />

            <!-- Тёмный градиент поверх картинки (чтобы текст читался) -->
            <View
                android:id="@+id/gradientOverlay"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/gradient_top_to_bottom" />

            <!-- Название карты в левом верхнем углу -->
            <TextView
                android:id="@+id/cardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/ys_display_medium"
                android:textSize="18sp"
                android:textColor="?attr/cardTitleColor"
                android:text="Название карты"
                android:shadowColor="@android:color/black"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_gravity="start|top" />

        </FrameLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>