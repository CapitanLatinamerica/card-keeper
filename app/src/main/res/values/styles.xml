<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========== БАЗОВЫЕ СТИЛИ ========== -->
    <style name="BaseEditTextStyle">
        <item name="android:drawableStart">@drawable/ic_find</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLines">1</item>
        <item name="android:maxLength">50</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/secondary_grey</item>
        <item name="android:background">@drawable/rounded_edittext</item>
        <item name="android:textCursorDrawable">@drawable/cursor</item>
    </style>

    <style name="MyAwesomeEditText" parent="BaseEditTextStyle" />

    <style name="TextAppearance.Evercard" parent="TextAppearance.Evercard.Tab" />

    <style name="TextAppearance.Evercard.Tab" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <!-- ========== ТАБЫ ========== -->
    <style name="Widget.Evercard.TabLayout" parent="Widget.MaterialComponents.TabLayout">


        <item name="tabIndicator">@drawable/tab_indicator_rounded</item>
        <item name="tabIndicatorFullWidth">false</item>

        <!-- Режим -->
        <item name="tabMode">scrollable</item>
        <item name="tabGravity">start</item>    <!-- Прижимает их к началу -->
        <item name="android:paddingStart">0dp</item> <!-- Убирает отступы -->
        <item name="android:paddingEnd">0dp</item>

        <!-- 3. Отступы самого текста, чтобы индикатор соседних табов не слипался -->
        <item name="tabPaddingStart">16dp</item>
        <item name="tabPaddingEnd">16dp</item>

        <!-- Индикатор -->
        <item name="tabIndicatorColor">?attr/colorOnPrimary</item>
        <item name="tabIndicatorHeight">8dp</item>
        <item name="tabIndicatorGravity">bottom</item>

        <!-- Цвета текста -->
        <item name="tabTextColor">@color/text_dark_gray</item>
        <item name="tabSelectedTextColor">?attr/colorOnPrimary</item>

        <!-- Шрифт и регистр -->
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="tabTextAppearance">@style/TextAppearance.Evercard.Tab</item>

        <!-- Фон -->
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- ========== BOTTOM NAVIGATION ========== -->
    <style name="Widget.Evercard.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">


        <item name="android:layout_height">56dp</item>
        <item name="android:background">?attr/colorSecondaryVariant</item>
        <item name="elevation">28dp</item>
        <item name="itemIconTint">@color/white</item>
        <item name="itemTextColor">@color/black</item>
        <item name="itemBackground">@null</item>
        <item name="itemHorizontalTranslationEnabled">false</item>
        <item name="itemRippleColor">@null</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Evercard.BottomNavigation</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Evercard.BottomNavigation</item>
    </style>

    <style name="TextAppearance.Evercard.BottomNavigation">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- ========== ДИАЛОГИ ========== -->
    <style name="Theme.Evercard.FullScreenDialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/teal_700</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>


</resources>