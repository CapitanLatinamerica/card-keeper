<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="main_style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="titleTextColor">@color/black</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="MyAwesomeToolbar" parent="main_style">
        <item name="background">?attr/colorOnPrimary</item>
        <item name="titleTextColor">?attr/colorOnSecondary</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
        <item name="thumbTint">@color/switch_thumb_color</item>
        <item name="trackTint">@color/switch_track_color</item>
    </style>

    <style name="MyAwesomeEditText">
        <item name="android:drawableStart">@drawable/ic_find</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:hint">Поиск</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLines">1</item>
        <item name="android:maxLength">50</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/teal_200</item>
        <item name="android:background">@drawable/rounded_edittext</item>
        <item name="android:textCursorDrawable">@drawable/cursor</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">0</item>
        <item name="android:shadowColor">@android:color/transparent</item>
    </style>

    <style name="MyAwesomeRoundedBigCover">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>



    <!-- Стиль для BottomNavigationView -->
    <style name="BottomNavigationAppearance" >
        <!-- Основные параметры -->
        <item name="android:layout_height">56dp</item>
        <item name="android:background">?attr/colorSecondaryVariant</item>
        <item name="elevation">28dp</item>

        <!-- Цвета иконок и текста -->
        <item name="itemIconTint">@color/white</item>
        <item name="itemTextColor">@color/black</item> <!-- Важно! -->

        <!-- Фон и поведение -->
        <item name="itemBackground">@null</item>
        <item name="itemHorizontalTranslationEnabled">false</item>
        <item name="itemRippleColor">@null</item>

        <!-- Общий стиль текста -->
        <item name="itemTextAppearanceActive">@style/BottomNavigationText</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavigationText</item>

    </style>

    <!-- Единый стиль текста (без указания цвета!) -->
    <style name="BottomNavigationText">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="MyAwesomeTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/teal_700</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>

        <!-- Текстовая стилизация -->
        <item name="hintTextColor">@color/teal_700</item>
        <item name="android:textColorHint">?attr/colorOnPrimary</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="FullScreenDialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/teal_700</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <!-- Стиль для TabLayout -->
    <style name="TabLayoutTheme" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">?attr/colorOnPrimary</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabIndicatorGravity">bottom</item>
        <item name="tabTextColor">?attr/colorOnPrimary</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
        <item name="android:fontFamily">@font/ys_display_medium</item> <!-- Шрифт -->
        <item name="android:textSize">14sp</item> <!-- Размер шрифта -->
        <item name="android:background">#D2C1F6</item>
    </style>

</resources>